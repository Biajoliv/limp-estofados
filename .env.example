POSTGRES_DB=nome_do_banco
POSTGRES_USER=usuario_do_banco
POSTGRES_PASSWORD=senha_do_banco

# Origem do frontend, usada pelo CORS (CorsConfig). Em dev local, deixe o
# valor abaixo se estiver servindo o Frontend/ na porta 5500 (ver README).
FRONTEND_URL=http://localhost:5500

# SMTP para envio de e-mail de notificação (Spring Mail). Sem credenciais,
# o envio falha silenciosamente (protegido por try/catch) — não bloqueia a
# aplicação, só impede o e-mail de sair.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=